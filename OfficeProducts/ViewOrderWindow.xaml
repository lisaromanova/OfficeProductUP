<Window x:Class="OfficeProducts.ViewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfficeProducts"
        mc:Ignorable="d"
        Title="Заказ" Icon="\Resources\icon.ico" Height="600" MinHeight="600" MinWidth="800" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="30,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <Image Margin="0,0,20,0" Source="\Resources\logo.png"/>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Пиши-стирай" Style="{StaticResource TextBlockHeader}"/>
        </StackPanel>
        <Frame NavigationUIVisibility="Hidden" Name="frmMain" Grid.Row="1"/>
    </Grid>
</Window>
