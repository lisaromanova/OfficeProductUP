<Page x:Class="OfficeProducts.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OfficeProducts.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <ListView HorizontalContentAlignment="Stretch" Name="lstProduct" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1">
                        <Grid Margin="5" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>
                            <Image Height="130" Source="{Binding Product.Photo}" Grid.Column="0"/>
                            <StackPanel VerticalAlignment="Center" Grid.Column="1">
                                <TextBlock Style="{StaticResource TextBlockBase}" FontWeight="Bold" Text="{Binding Product.ProductName}"/>
                                <TextBlock Style="{StaticResource TextBlockBase}" TextWrapping="Wrap" Text="{Binding Product.ProductDescription}"/>
                                <TextBlock Style="{StaticResource TextBlockBase}" Text="{Binding Product.ManufacturerProduct.ManufacturerName, StringFormat=Производитель: {0}}"/>
                                <TextBlock Style="{StaticResource TextBlockBase}">
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding Product.Cost, Mode=OneWay}" TextDecorations="{Binding Product.OldCost}"/>
                                    <Run Text="{Binding Product.NewCost, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource TextBlockBase}" Text="{Binding Product.ProductDiscountAmount, StringFormat=Скидка: {0}%}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="2">
                                <GroupBox VerticalAlignment="Center" Header="Количество" Style="{StaticResource GroupBoxStyle}" >
                                    <TextBox Uid="{Binding Product.ProductArticleNumber}" Margin="5" Name="tbCount" HorizontalContentAlignment="Center" Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="tbCount_TextChanged"/>
                                </GroupBox>
                                <Button Uid="{Binding Product.ProductArticleNumber}" Name="btnDeleteProduct" Content="Удалить" Width="100" Style="{StaticResource ButtonTemplate}" Click="btnDeleteProduct_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Сумма заказа:" Style="{StaticResource TextBlockBase}"/>
                <TextBlock Name="tbSum"  Style="{StaticResource TextBlockBase}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Сумма скидки:" Style="{StaticResource TextBlockBase}"/>
                <TextBlock Name="tbSumDiscount" Style="{StaticResource TextBlockBase}"/>
            </StackPanel>
        </StackPanel>
        <Button Name="btnCheckout" Grid.Row="2" Style="{StaticResource ButtonTemplate}" Width="200" Height="40" HorizontalAlignment="Right" Content="Оформить заказ" Click="btnCheckout_Click" Cursor="Hand"/>
        <GroupBox HorizontalAlignment="Left" Width="400" Header="Пункт выдачи" Style="{StaticResource GroupBoxStyle}">
            <ComboBox Name="cbPickPoint" Margin="5"/>
        </GroupBox>
        <TextBlock Margin="0,0,10,0" Name="tbUser" HorizontalAlignment="Right" Grid.Row="0" VerticalAlignment="Center" Style="{StaticResource TextBlockBase}"/>
    </Grid>
</Page>
