<Page x:Class="OfficeProducts.Pages.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OfficeProducts.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductListPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Name="tbCount" Style="{StaticResource TextBlockBase}"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="0">
                <GroupBox Width="250" Header="Сортировка" Style="{StaticResource GroupBoxStyle}">
                    <ComboBox Margin="5" Name="cbSort" SelectionChanged="cbSort_SelectionChanged">
                        <ComboBoxItem>
                            По возрастанию стоимости
                        </ComboBoxItem>
                        <ComboBoxItem>
                            По убыванию стоимости
                        </ComboBoxItem>
                    </ComboBox>
                </GroupBox>
                <GroupBox Width="200" Header="Скидка" Style="{StaticResource GroupBoxStyle}">
                    <ComboBox Margin="5" Name="cbDiscount" SelectionChanged="cbSort_SelectionChanged">
                        <ComboBoxItem>
                            Все диапазоны
                        </ComboBoxItem>
                        <ComboBoxItem>
                            От 0 - 9,99%
                        </ComboBoxItem>
                        <ComboBoxItem>
                            От 10 - 14,99%
                        </ComboBoxItem>
                        <ComboBoxItem>
                            15% и более
                        </ComboBoxItem>
                    </ComboBox>
                </GroupBox>
                <GroupBox Width="300" Header="Поиск по наименованию" Style="{StaticResource GroupBoxStyle}">
                    <TextBox Margin="5" Name="tbSearch" TextChanged="tbSearch_TextChanged"/>
                </GroupBox>
            </StackPanel>
        </StackPanel>
        <TextBlock Name="tbEmpty" Text="Записи не найдены" FontSize="40" FontFamily="Comic Sans MS" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,169,0,0" Grid.Row="1"/>
        <ListView HorizontalContentAlignment="Stretch" Name="lstProduct" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Background="{Binding ColorProduct}">
                        <Grid Margin="5" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>
                            <Image Height="130" Source="{Binding Photo}" Grid.Column="0"/>
                            <StackPanel VerticalAlignment="Center" Grid.Column="1">
                                <TextBlock Style="{StaticResource TextBlockBase}" FontWeight="Bold" Text="{Binding ProductName}"/>
                                <TextBlock Style="{StaticResource TextBlockBase}" TextWrapping="Wrap" Text="{Binding ProductDescription}"/>
                                <TextBlock Style="{StaticResource TextBlockBase}" Text="{Binding ManufacturerProduct.ManufacturerName, StringFormat=Производитель: {0}}"/>
                                <TextBlock Style="{StaticResource TextBlockBase}">
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding Cost, Mode=OneWay}" TextDecorations="{Binding OldCost}"/>
                                    <Run Text="{Binding NewCost, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource TextBlockBase}" HorizontalAlignment="Center" Grid.Column="2" Text="{Binding ProductDiscountMax}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
