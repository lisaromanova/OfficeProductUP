<Page x:Class="OfficeProducts.Pages.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OfficeProducts.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductListPage">

    <Grid>
        <ListView HorizontalContentAlignment="Stretch" Name="lstProduct" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>
                            <Image Width="150" Source="{Binding Photo}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="Bold" Text="{Binding ProductName}"/>
                                <TextBlock TextWrapping="Wrap" Text="{Binding ProductDescription}"/>
                                <TextBlock Text="{Binding ManufacturerProduct.ManufacturerName, StringFormat=Производитель: {0}}"/>
                                <TextBlock Text="{Binding ProductCost, StringFormat=Цена: {0}}"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Center" Grid.Column="2" Text="{Binding ProductDiscountAmount}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
