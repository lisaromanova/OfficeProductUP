<Page x:Class="OfficeProducts.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OfficeProducts.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage">

    <Grid Margin="10">
        <ScrollViewer>
            <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock FontSize="24" HorizontalAlignment="Center" Text="Авторизация" Style="{StaticResource TextBlockHeader}"/>
                <GroupBox  Style="{StaticResource GroupBoxStyle}" Header="Логин">
                    <TextBox Margin="5" Name="tbLogin"/>
                </GroupBox>
                <GroupBox Style="{StaticResource GroupBoxStyle}" Header="Пароль">
                    <PasswordBox Margin="5" Name="pswPassword" PasswordChar="*"/>
                </GroupBox>
                <StackPanel Margin="5" Name="stackCaptcha" Visibility="Collapsed">
                    <Border Width="200" BorderThickness="1" BorderBrush="Black">
                        <Canvas Name="canvasCaptcha" Width="200" Height="70"/>
                    </Border>
                    <GroupBox  Style="{StaticResource GroupBoxStyle}" Header="Введите Captcha">
                        <TextBox Margin="5" Name="tbCaptcha"/>
                    </GroupBox>
                </StackPanel>
                <Button Name="btnEnter" Margin="10" Content="Войти" Style="{StaticResource ButtonTemplate}" Click="btnEnter_Click"/>
                <Button Name="btnEnterGuest" Margin="10" Content="Войти как гость" Style="{StaticResource ButtonTemplate}" Click="btnEnterGuest_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
