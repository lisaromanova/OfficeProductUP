<Window x:Class="OfficeProducts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfficeProducts"
        mc:Ignorable="d"
        Title="Пиши-стирай" Height="450" Width="800" MinHeight="450" MinWidth="800" Icon="\Resources\icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Image Margin="0,0,20,0" Source="\Resources\logo.png"/>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Пиши-стирай" Style="{StaticResource TextBlockHeader}"/>
        </StackPanel>
        <TextBlock Text="{Binding Name}" HorizontalAlignment="Right"/>
        <Frame NavigationUIVisibility="Hidden" Name="frmMain" Grid.Row="1"/>
    </Grid>
</Window>
