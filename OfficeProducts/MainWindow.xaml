<Window x:Class="OfficeProducts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfficeProducts"
        mc:Ignorable="d"
        Title="Пиши-стирай" Height="500" Width="800" MinHeight="500" MinWidth="800" Icon="\Resources\icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="30,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <Image Margin="0,0,20,0" Source="\Resources\logo.png"/>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Пиши-стирай" Style="{StaticResource TextBlockHeader}"/>
        </StackPanel>
        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource TextBlockBase}" Margin="0,0,15,0" Text="{Binding Name}"  />
            <Button Width="100" Name="btnExit" Visibility="{Binding ButtonVisible}" Style="{StaticResource ButtonTemplate}" Content="Выход" Click="btnExit_Click"/>
        </StackPanel>
        <Frame NavigationUIVisibility="Hidden" Name="frmMain" Grid.Row="1"/>
    </Grid>
</Window>
